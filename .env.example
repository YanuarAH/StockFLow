# Local Prisma URL. Vercel Supabase Integration provides POSTGRES_PRISMA_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase Auth. NEXT_PUBLIC_* works locally; Vercel integration names are also supported.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Optional: Google Gemini API key for the warehouse assistant
GEMINI_API_KEY=""
